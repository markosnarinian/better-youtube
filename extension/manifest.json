{
  "manifest_version": 3,
  "name": "Better YouTube",
  "version": "0.1.0",
  "description": "Quiet ads, fewer distractions, intentional playback, and PiP resume recovery.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
  "action": {
    "default_title": "Better YouTube",
    "default_popup": "popup.html",
    "default_icon": {"64": "icons/icon-64.png", "128": "icons/icon-128.png"}
  },
  "icons": {"64": "icons/icon-64.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png"},
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["defaults.js", "player.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["defaults.js", "settings.js"],
      "run_at": "document_start"
    }
  ]
}
